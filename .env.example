# SAPPHIRE Environment Configuration
# Zero PII Egress. Strict Fail-Loud Financial Contracts.

# Database Persistence (PostgreSQL)
DATABASE_URL=postgresql://postgres:assassin@localhost:54329/assassin
TEST_DATABASE_URL=postgresql://postgres:assassin@localhost:54329/assassin_test

# Observability & Logging
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317

# JARVIS — shared Watchtower inference (homelab-k3s jarvis/jarvis)
# Vault trust boundary. OPENAI_BASE_URL is an accepted alias for VAULT_INFERENCE_URL.
# Prefer ingress (LAN) or loopback hostPort (on the node). Not 192.168.1.92:8080.
# Exclusive GPU: homelab-k3s/scripts/jarvis-lease.sh acquire|release|touch
VAULT_INFERENCE_URL=http://ai.watchtower.local/v1
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
VAULT_INFERENCE_MODEL=qwen36-coder-hybrid
VAULT_INFERENCE_TIMEOUT=30.0
