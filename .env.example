# ASSASSIN Environment Configuration
# Zero PII Egress. Strict Fail-Loud Financial Contracts.

# Database Persistence (PostgreSQL)
DATABASE_URL=postgresql://postgres:assassin@localhost:54329/assassin
TEST_DATABASE_URL=postgresql://postgres:assassin@localhost:54329/assassin_test

# Observability & Logging
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317

# Watchtower Containerized Inference Engine (Vault Trust Boundary)
# Serves Qwen 35B MoE via OpenAI-compatible API on homelab-k3s
VAULT_INFERENCE_URL=http://192.168.1.92:8080/v1
VAULT_INFERENCE_MODEL=qwen36-coder-hybrid
VAULT_INFERENCE_TIMEOUT=30.0
